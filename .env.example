# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Cadena de conexión de MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/
# Para Atlas sería algo como:
# MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/

MONGO_DB=AutoSmartDB

# Clave para firmar la sesión de Flask (el carrito). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcionales del scraper
# AUTOSMART_META=1200
# AUTOSMART_VENTANAS=3
